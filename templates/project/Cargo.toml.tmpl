[workspace]
resolver = "3"
members = ["crates/*", "apps/*"]

[workspace.package]
edition = "2024"
rust-version = "{{rust_version}}"

[workspace.metadata.buildkit]
version = "{{bk_version}}"
flow = "{{flow}}"
repo = "{{repo}}"

[workspace.dependencies]
buildkit = { git = "https://github.com/medaminben/buildkit-rust", tag = "v{{bk_version}}" }

[workspace.lints.rust]
unsafe_code = "deny"

[workspace.lints.clippy]
pedantic = { level = "warn", priority = -1 }
